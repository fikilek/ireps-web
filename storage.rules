rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // TEMPORARY REPORT PLATFORM V1 SPRINT POLICY
    //
    // Authenticated Storage read/write access is intentionally retained while
    // Report Platform functionality is completed and integration-tested.
    //
    // This is NOT the final Report Platform security model.
    // Storage hardening is intentionally deferred to the final sprint security
    // component and must be completed before final TEST/LIVE rollout.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}