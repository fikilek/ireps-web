rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Saved reports carry customer names, account numbers and addresses, so only
    // the person who generated a report may reach it (GMR-R004). The server
    // lists, signs downloads and deletes through the Admin SDK, which these
    // rules do not govern.
    match /generated-reports/{ownerUid}/{reportPath=**} {
      allow read, write: if request.auth != null && request.auth.uid == ownerUid;
    }

    function unlocked(filename) {
      return !firestore.exists(/databases/(default)/documents/qaEvidenceLocks/$(filename));
    }
    // Review preparation freezes original objects before presenting them.
    match /{folder}/{group}/{filename} {
      allow write: if request.auth != null
        && folder in ['meters', 'premises', 'informal_erfs', 'lifecycleInstructions']
        && unlocked(filename);
    }
    match /trns/lifecycle_instructions/{trnId}/{filename} {
      allow write: if request.auth != null && unlocked(filename);
    }
    match /trns/lifecycle_instructions/{filename} {
      allow write: if request.auth != null && unlocked(filename);
    }
    match /{topFolder}/{rest=**} {
      allow read: if request.auth != null
        && topFolder != 'generated-reports';
    }
  }
}
