rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && me().get('accountStatus', '') == 'ACTIVE'; }
    function role() { return me().get('employment', {}).get('role', ''); }
    function platform() { return active() && role() in ['SPU', 'ADM']; }
    function office() { return active() && role() in ['SPU', 'ADM', 'MNG', 'SPV']; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }
    function changed(before, after, keys) { return after.diff(before).affectedKeys().hasOnly(keys); }
    function ownMetadata() {
      return changed(resource.data.get('metadata', {}), request.resource.data.get('metadata', {}),
        ['updatedAt', 'updatedByUid', 'updatedByUser'])
        && (request.resource.data.get('metadata', {}) == resource.data.get('metadata', {})
          || request.resource.data.get('metadata', {}).get('updatedByUid', request.auth.uid) == request.auth.uid);
    }
    function allowedActiveWorkbase() {
      let access = request.resource.data.get('access', {});
      let previous = resource.data.get('access', {});
      return changed(previous, access, ['activeWorkbase'])
        && (access.get('activeWorkbase', null) == previous.get('activeWorkbase', null)
          || (active() && (role() == 'SPU' || access.get('activeWorkbase', null) in previous.get('workbases', []))));
    }
    function safeOnboarding() {
      let before = resource.data.get('onboarding', {});
      let after = request.resource.data.get('onboarding', {});
      let steps = after.get('steps', {});
      let oldSteps = before.get('steps', {});
      return changed(before, after, ['status', 'steps', 'mustChangePassword'])
        && (after.get('status', '') == before.get('status', '') || (active() && after.get('status', '') in ['PENDING', 'COMPLETED']))
        && (after.get('mustChangePassword', false) == before.get('mustChangePassword', false)
          || (active() && after.get('mustChangePassword', false) == false))
        && changed(oldSteps, steps, ['emailVerified', 'phoneVerified', 'profileCompleted'])
        && (steps.get('emailVerified', false) == oldSteps.get('emailVerified', false) || request.auth.token.get('email_verified', false))
        && (steps.get('phoneVerified', false) == oldSteps.get('phoneVerified', false) || request.auth.token.get('phone_number', '') != '');
    }
    match /users/{uid} {
      allow get: if own(uid) || office();
      allow list: if office();
      // Role, company and workbase grants are server-owned. Onboarding UI flags
      // confer no authority: active account and trusted employment are always required.
      allow update: if own(uid)
        && changed(resource.data, request.resource.data, ['profile', 'access', 'onboarding', 'metadata', 'contact'])
        && changed(resource.data.get('profile', {}), request.resource.data.get('profile', {}), ['name', 'surname', 'displayName', 'phoneNumber', 'email'])
        && changed(resource.data.get('contact', {}), request.resource.data.get('contact', {}), ['phoneNumber', 'cell'])
        && allowedActiveWorkbase() && safeOnboarding() && ownMetadata();
      // Existing platform account administration; no self-activation or grant edits.
      allow update: if platform() && !own(uid)
        && changed(resource.data, request.resource.data, ['accountStatus'])
        && request.resource.data.accountStatus in ['ACTIVE', 'DISABLED']
        && resource.data.accountStatus in ['ACTIVE', 'DISABLED'];
      allow create, delete: if false;
    }
    match /serviceProviders/{id} {
      allow read: if active();
      allow create: if platform();
      allow update: if platform() || (office() && role() in ['MNG', 'SPV']
        && me().employment.serviceProvider.id == id
        && changed(resource.data, request.resource.data, ['profile', 'owner', 'offices', 'metadata']) && ownMetadata());
      allow delete: if false;
    }
    function hasLm(lm) {
      let access = me().get('access', {});
      let grants = access.get('workbases', []);
      let current = access.get('activeWorkbase', null);
      return active() && (lm in grants || lm == current
        || (current is map && lm == current.get('lmPcode', current.get('pcode', current.get('id', ''))))
        || (exists(/databases/$(database)/documents/lms/$(lm))
          && {'id': lm, 'name': get(/databases/$(database)/documents/lms/$(lm)).data.name} in grants));
    }
    function tcAllowed(data) {
      let target = data.get('bgo', {});
      return hasLm(data.lmPcode) && (office()
        || (target.get('targetType', '') == 'SP' && target.get('targetId', '') == me().get('employment', {}).get('serviceProvider', {}).get('id', ''))
        || (target.get('targetType', '') == 'TEAM' && (request.auth.uid in get(/databases/$(database)/documents/teams/$(target.targetId)).data.get('memberUids', []) || request.auth.uid in get(/databases/$(database)/documents/teams/$(target.targetId)).data.get('scope', {}).get('memberUserIds', []))));
    }
    match /tc_uploads/{id} {
      allow read: if tcAllowed(resource.data);
      allow write: if false;
      match /history/{event} { allow read: if office() && tcAllowed(get(/databases/$(database)/documents/tc_uploads/$(id)).data); allow write: if false; }
    }
    match /tc_rows/{id} {
      allow read: if tcAllowed(get(/databases/$(database)/documents/tc_uploads/$(resource.data.tcId)).data);
      allow write: if false;
    }
    match /trns/{id} {
      allow read: if active();
      // All submission/ITO/QA mutations use their authorised server operations.
      allow write: if false;
      match /history/{event} { allow read: if office(); allow write: if false; }
      match /qaHistory/{event} { allow read, write: if false; }
      match /qaVersions/{version} { allow read, write: if false; }
      match /qaAmendments/{event} { allow read, write: if false; }
    }
    match /tc_source_files/{id} {
      allow read: if office() && resource.data.committed == true
        && hasLm(resource.data.lmPcode);
      allow write: if false;
    }
    match /qaNotifications/{id} {
      allow read: if active() && resource.data.recipientUid == request.auth.uid;
      allow write: if false;
    }
    match /qaEmailOutbox/{id} { allow read, write: if false; }
    match /qaEvidenceLocks/{file} { allow read, write: if false; }
    match /premises/{id} {
      allow read: if active();
      allow create, delete: if false;
      // Business changes go through the authenticated Cloud Function so it can
      // validate, prevent stale overwrites, stamp QA_PENDING and write history.
      allow update: if false;
      match /qaHistory/{event} { allow read: if active(); allow write: if false; }
    }
    match /settings/{id} { allow read: if active(); allow write: if platform(); }
    match /notifications/{id} { allow read: if active(); allow write: if false; }
    // Explicit inventory of existing readers. New collections/subcollections
    // acquire no client access automatically. All these writers are server-side.
    match /{collection}/{id} {
      allow read: if active() && collection in [
        'account_master', 'asts', 'batch_erf_overrides', 'bgo_batches', 'bgo_rows',
        'conlog_sales_atomic', 'conlog_sales_monthly', 'conlog_sales_monthly_lm', 'conlog_sales_monthly_lm_groups',
        'countries', 'demo_sales_meters', 'districts', 'districtMunicipalities', 'towns', 'wards',
        'erfs', 'field_account_data', 'fwr_live_locations',
        'geo_fences', 'irepsSelectLookups', 'ireps_erfs', 'lms', 'meter_master',
        'mread_staging', 'mread_staging_cycles', 'provinces', 'refused_submissions',
        'registry_accounts', 'registry_erfs', 'registry_jobs', 'registry_meters', 'registry_mread',
        'registry_premises', 'registry_wards', 'registry_workbases',
        'report_electricity_population', 'report_trn_anomaly', 'report_trn_no_access', 'report_trn_normalisation', 'report_trn_user_activity',
        'sales-all-meters', 'stores', 'tb_rows', 'tb_uploads',
        'team_member_history', 'teams', 'vending_providers'
      ];
    }
    match /{document=**} { allow read, write: if false; }
  }
}
